# Archneo starts with the pinned ROCKNIX SM8550 configuration. The compile-smoke
# build has no built-in initramfs; complete images replace this setting with the
# generated Archneo .cpio.gz archive before the final Image relink.
CONFIG_INITRAMFS_SOURCE=""
CONFIG_DEFAULT_HOSTNAME="archneo"
CONFIG_LOCALVERSION="-archneo"
# CONFIG_LOCALVERSION_AUTO is not set
