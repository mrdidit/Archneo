# ABL is a prerequisite and is not downloaded or flashed by Archneo. These
# values identify the public release against which the boot contract was
# investigated.
ROCKNIX_ABL_BASELINE_VERSION="v1.1.8"
ROCKNIX_ABL_LINUXLOADER_COMMIT="22ac43cef216dfd2caefef26cd46db0d8e0d4d71"
ROCKNIX_ABL_RELEASE_SHA256="b217fd8a07acb0346b4704df3805298b2d7025e27fd59a7c11417a6803bab8af"

# Arch Linux ARM publishes this as a moving target. It must be signature
# verified and snapshotted before a release can claim reproducibility.
ARCHLINUXARM_ROOTFS_URL="http://os.archlinuxarm.org/os/ArchLinuxARM-aarch64-latest.tar.gz"
ARCHLINUXARM_ROOTFS_SIGNATURE_URL="http://os.archlinuxarm.org/os/ArchLinuxARM-aarch64-latest.tar.gz.sig"
ARCHLINUXARM_SIGNING_FINGERPRINT="68B3537F39A313B3E574D06777193F152BDBE6A6"
ARCHLINUXARM_OBSERVED_LAST_MODIFIED="2026-08-05T12:41:36Z"
ARCHLINUXARM_OBSERVED_SIZE="829367415"

# Official Arch Linux ARM keyring used to verify the moving rootfs snapshot.
ARCHLINUXARM_KEYRING_COMMIT="91e6b11698f8df66042d56aaa56fbe9c9263847d"
ARCHLINUXARM_KEYRING_URL="https://raw.githubusercontent.com/archlinuxarm/archlinuxarm-keyring/91e6b11698f8df66042d56aaa56fbe9c9263847d/archlinuxarm.gpg"
ARCHLINUXARM_KEYRING_SHA256="50a08f82ce3cd524a552da4bfa37f3e04b2c9da468e2fce5783474b58a34c518"

ROCKNIX_EXTRA_FIRMWARE_URL="https://github.com/ROCKNIX/extra-firmware.git"
ROCKNIX_EXTRA_FIRMWARE_COMMIT="2b7207cfcb80c53c09dc6e04165789ecaf2d3348"
ROCKNIX_EXTRA_FIRMWARE_ARCHIVE_URL="https://github.com/ROCKNIX/extra-firmware/archive/2b7207cfcb80c53c09dc6e04165789ecaf2d3348.tar.gz"
ROCKNIX_EXTRA_FIRMWARE_ARCHIVE_SHA256="1c1db6a797f23a3d179904941e4a869679a514c6f43687e20954c5d96cad4f49"

# Pin values that ROCKNIX normally derives from the build date so that the
# resulting Android boot-image header is deterministic.
ABL_OS_VERSION="12.0.0"
ABL_OS_PATCH_LEVEL="2026-08"
