# Source lock for the first Archneo SM8550 bring-up.
#
# This file is sourced by Bash. Keep values shell-safe and update checksums in
# the same change as their URLs or revisions.

ROCKNIX_DISTRIBUTION_URL="https://github.com/ROCKNIX/distribution.git"
ROCKNIX_DISTRIBUTION_COMMIT="13e18947d2d41b17015f5df18405adefc4dfb2f5"

LINUX_VERSION="7.2"
LINUX_URL="https://www.kernel.org/pub/linux/kernel/v7.x/linux-7.2.tar.xz"
LINUX_SHA256="f9fef3d14c0df53819026f4be74459835c2a0b0dcbf5b5bbd9ea19f0829402b3"

MKBOOTIMG_VERSION="d2bb0af5ba6d3198a3e99529c97eda1be0b5a093"
