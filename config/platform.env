# ABL-facing removable-media contract. Keep ROCKNIX_ABL_BOOT_LABEL unchanged:
# Archneo intentionally conforms to ROCKNIX-ABL rather than modifying ABL.
ROCKNIX_ABL_BOOT_LABEL="ROCKNIX"
ROCKNIX_ABL_BOOT_PARTITION_NAME="system"
ARCHNEO_ROOT_LABEL="ARCHNEO_ROOT"
ARCHNEO_HOME_LABEL="ARCHNEO_HOME"
ABL_SYSTEM_PART_START_SECTORS="32768"
ABL_SYSTEM_PART_SIZE_MIB="2048"

# The root partition is fixed at 30 GiB. The image contains a 1 GiB home
# seed; Archneo expands that final partition to the remaining media on first
# boot without changing its filesystem UUID.
ARCHNEO_ROOT_SIZE_MIB="30720"
ARCHNEO_HOME_SEED_SIZE_MIB="1024"

# Stable filesystem identities. Device nodes and partition paths are never
# written into the kernel command line or /etc/fstab.
ARCHNEO_BOOT_FS_UUID="B379-CA5E"
ARCHNEO_ROOT_FS_UUID="08c30b77-e15c-5ef8-af02-494ed4646411"
ARCHNEO_HOME_FS_UUID="3d5f2fb4-4871-503c-ad41-e1d9ebdcb52b"

# Deterministic GPT identity for the Pocket S 2K image profile.
ARCHNEO_DISK_GUID="1b706170-e77d-5e8c-bc44-596e3e570993"
ARCHNEO_BOOT_PART_GUID="40e262aa-4843-5980-be85-ec8a54682c32"
ARCHNEO_ROOT_PART_GUID="e9a6877c-a12d-526a-bca1-21da9a81549a"
ARCHNEO_HOME_PART_GUID="fb47bc54-d272-5250-9102-2e6259d4a19a"

ARCHNEO_ROOTFS_SCHEMA="5"
