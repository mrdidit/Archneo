#!/usr/bin/env bash

set -euo pipefail

marker="/var/lib/archneo/credentials-set"
[[ ! -e "$marker" ]] || exit 0

printf '\nArchneo first boot\n'
printf 'Set a password for each local administrator account.\n'
printf 'The normal login prompt starts after this setup completes.\n\n'

printf '1/2: Set the root password.\n'
until passwd root; do
  printf 'The root password was not changed; please try again.\n' >&2
done

printf '\n2/2: Set the deck password (used by sudo).\n'
until passwd deck; do
  printf 'The deck password was not changed; please try again.\n' >&2
done

install -d -m 0755 /var/lib/archneo
touch "$marker"
printf '\nCredentials saved. The normal login prompt will start now.\n'
